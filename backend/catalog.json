{
  "actions": [
    {
      "id": "DB_PRECHECK",
      "name": "Action 1: Pre-check DB Services",
      "domain": "CNTT",
      "capability": "HEALTH_CHECK",
      "description": "Kiểm tra tình trạng ClickHouse qua HTTP ping và PostgreSQL qua systemd trước khi bảo trì",
      "inputs": [
        {
          "name": "clickhouse_url",
          "label": "ClickHouse Ping URL",
          "type": "string",
          "default": "http://127.0.0.1:8123/ping",
          "required": true,
          "validation": "^https?:\\/\\/.+",
          "placeholder": "http://127.0.0.1:8123/ping",
          "description": "URL endpoint HTTP ping của ClickHouse"
        },
        {
          "name": "clickhouse_timeout",
          "label": "Ping Timeout (s)",
          "type": "number",
          "default": 10,
          "required": true,
          "validation": "^[1-9][0-9]*$",
          "placeholder": "10",
          "description": "Thời gian chờ tối đa khi kiểm tra HTTP ping (giây)"
        },
        {
          "name": "postgres_service",
          "label": "PostgreSQL Service Name",
          "type": "string",
          "default": "postgresql@18-main.service",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$",
          "placeholder": "postgresql@18-main.service",
          "description": "Tên systemd service của PostgreSQL"
        }
      ],
      "outputs": [
        {
          "name": "is_ch_ok",
          "type": "boolean",
          "description": "ClickHouse HTTP ping thành công (status == 200)"
        },
        {
          "name": "is_pg_ok",
          "type": "boolean",
          "description": "PostgreSQL service đang active"
        },
        {
          "name": "ch_status_code",
          "type": "number",
          "description": "HTTP Status Code trả về"
        },
        {
          "name": "pg_state",
          "type": "string",
          "description": "Trạng thái systemd chi tiết"
        }
      ],
      "task_template": [
        {
          "name": "Ping ClickHouse HTTP endpoint",
          "module": "ansible.builtin.uri",
          "args": {
            "url": "{{ clickhouse_url }}",
            "timeout": "{{ clickhouse_timeout }}"
          },
          "register": "ch_health",
          "failed_when": false
        },
        {
          "name": "Check PostgreSQL Systemd Service Status",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ postgres_service }}"
          },
          "register": "pg_health",
          "failed_when": false
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 30
      },
      "verification": {
        "type": "embedded",
        "note": "Pre-check tự lưu facts vào output_action1 phục vụ các bước sau"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL"
      },
      "riskDefault": "LOW"
    },
    {
      "id": "DB_RESTART_CYCLE",
      "name": "Action 2: Restart Services Cycle",
      "domain": "CNTT",
      "capability": "SERVICE_RESTART",
      "description": "Dừng dịch vụ ClickHouse & Postgres, khởi động lại server và start lại dịch vụ",
      "inputs": [
        {
          "name": "clickhouse_service",
          "label": "ClickHouse Service Name",
          "type": "string",
          "default": "clickhouse-server",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$",
          "placeholder": "clickhouse-server",
          "description": "Tên systemd service ClickHouse"
        },
        {
          "name": "postgres_service",
          "label": "PostgreSQL Service Name",
          "type": "string",
          "default": "postgresql@18-main.service",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$",
          "placeholder": "postgresql@18-main.service",
          "description": "Tên systemd service PostgreSQL"
        },
        {
          "name": "reboot_timeout",
          "label": "Reboot Timeout (s)",
          "type": "number",
          "default": 300,
          "required": true,
          "validation": "^[1-9][0-9]*$",
          "placeholder": "300",
          "description": "Thời gian tối đa chờ máy chủ khởi động lại và kết nối SSH trở lại"
        }
      ],
      "outputs": [
        {
          "name": "restart_timestamp",
          "type": "string",
          "description": "Thời điểm khởi động lại xong (ISO8601)"
        },
        {
          "name": "uptime",
          "type": "string",
          "description": "Uptime máy chủ sau khi khởi động"
        }
      ],
      "task_template": [
        {
          "name": "Stop ClickHouse service",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ clickhouse_service }}",
            "state": "stopped"
          }
        },
        {
          "name": "Stop PostgreSQL service",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ postgres_service }}",
            "state": "stopped"
          }
        },
        {
          "name": "Reboot server",
          "module": "ansible.builtin.reboot",
          "args": {
            "reboot_timeout": "{{ reboot_timeout }}"
          }
        },
        {
          "name": "Start ClickHouse service",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ clickhouse_service }}",
            "state": "started"
          }
        },
        {
          "name": "Start PostgreSQL service",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ postgres_service }}",
            "state": "started"
          }
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 360
      },
      "verification": {
        "type": "embedded",
        "note": "Kiểm tra uptime server ngay sau reboot"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL",
        "note": "Reboot server không rollback được - leo thang on-call khi gặp lỗi"
      },
      "riskDefault": "HIGH"
    },
    {
      "id": "DB_POST_VERIFY",
      "name": "Action 3: Post-Restart Verification",
      "domain": "CNTT",
      "capability": "POST_VERIFICATION",
      "description": "Xác thực phục hồi của ClickHouse & PostgreSQL, so sánh trước/sau và xuất báo cáo tổng kết",
      "inputs": [
        {
          "name": "clickhouse_url",
          "label": "ClickHouse Ping URL",
          "type": "string",
          "default": "http://127.0.0.1:8123/ping",
          "required": true,
          "validation": "^https?:\\/\\/.+",
          "placeholder": "http://127.0.0.1:8123/ping",
          "description": "URL endpoint HTTP ping kiểm tra phục hồi"
        },
        {
          "name": "postgres_service",
          "label": "PostgreSQL Service Name",
          "type": "string",
          "default": "postgresql@18-main.service",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$",
          "placeholder": "postgresql@18-main.service",
          "description": "Tên systemd service PostgreSQL"
        }
      ],
      "outputs": [
        {
          "name": "ch_final",
          "type": "number",
          "description": "Mã HTTP status sau phục hồi"
        },
        {
          "name": "pg_final",
          "type": "string",
          "description": "Trạng thái systemd sau phục hồi"
        },
        {
          "name": "verdict",
          "type": "string",
          "description": "Kết luận tổng thể: PASS hoặc FAIL"
        }
      ],
      "task_template": [
        {
          "name": "Re-check ClickHouse Ping",
          "module": "ansible.builtin.uri",
          "args": {
            "url": "{{ clickhouse_url }}",
            "timeout": 10
          },
          "register": "verify_ch",
          "failed_when": false
        },
        {
          "name": "Re-check PostgreSQL Status",
          "module": "ansible.builtin.systemd",
          "args": {
            "name": "{{ postgres_service }}"
          },
          "register": "verify_pg"
        },
        {
          "name": "Assert both services active",
          "module": "ansible.builtin.assert",
          "args": {
            "that": "verify_ch.status == 200 and verify_pg.status.ActiveState == 'active'",
            "fail_msg": "CRITICAL: Restart cycle verification failed!",
            "success_msg": "SUCCESS: All DB services are healthy!"
          }
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 30
      },
      "verification": {
        "type": "embedded",
        "note": "Assert HTTP 200 và active systemd state"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL"
      },
      "riskDefault": "LOW"
    },
    {
      "id": "DISK_SPACE_CHECK",
      "name": "Check Disk Space on DB Server",
      "domain": "CNTT",
      "capability": "HEALTH_CHECK",
      "description": "Kiểm tra dung lượng ổ đĩa còn trống trên server database. Chỉ đọc dữ liệu, không có bất kỳ thay đổi nào.\n",
      "inputs": [
        {
          "name": "target_path",
          "label": "Target Path to Check",
          "type": "string",
          "default": "/",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$"
        },
        {
          "name": "warn_threshold_pct",
          "label": "Warning Threshold (%)",
          "type": "string",
          "default": "80",
          "required": true,
          "validation": ""
        }
      ],
      "outputs": [
        {
          "name": "disk_usage_result",
          "type": "string",
          "description": "Kết quả kiểm tra disk dạng text"
        }
      ],
      "task_template": [
        {
          "name": "Check Disk Space on DB Server",
          "module": "ansible.builtin.command",
          "args": {
            "cmd": "df -h {{ target_path }}"
          },
          "register": "disk_usage_result"
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 60
      },
      "verification": {
        "type": "embedded",
        "note": "Playbook self-verifies via Ansible module"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL"
      },
      "riskDefault": "LOW"
    },
    {
      "id": "DISK_CLEANUP_TMP",
      "name": "Clean Up Temp Files",
      "domain": "CNTT",
      "capability": "SERVICE_RESTART",
      "description": "",
      "inputs": [
        {
          "name": "tmp_dir",
          "label": "Temp Directory Path",
          "type": "string",
          "default": "/tmp",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$"
        },
        {
          "name": "older_than_days",
          "label": "Delete files older than (days)",
          "type": "string",
          "default": "7",
          "required": true,
          "validation": ""
        }
      ],
      "outputs": [
        {
          "name": "cleanup_result",
          "type": "string",
          "description": "Thông báo kết quả quá trình dọn dẹp"
        }
      ],
      "task_template": [
        {
          "name": "Clean Up Temp Files",
          "module": "ansible.builtin.shell",
          "args": {
            "executable": "/bin/bash",
            "cmd": "find {{ tmp_dir }} -type f -mtime +{{ older_than_days }} -delete && echo \"Cleaned successfully\""
          },
          "register": "cleanup_result"
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 60
      },
      "verification": {
        "type": "embedded",
        "note": "Playbook self-verifies via Ansible module"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL"
      },
      "riskDefault": "MEDIUM"
    },
    {
      "id": "DISK_VERIFY_AFTER",
      "name": "Verify Disk Space After Cleanup",
      "domain": "CNTT",
      "capability": "POST_VERIFY",
      "description": "Kiểm tra lại dung lượng disk sau khi dọn dẹp và in tóm tắt kết quả để lưu vào audit log.\n",
      "inputs": [
        {
          "name": "target_path",
          "label": "Target Path to Verify",
          "type": "string",
          "default": "/",
          "required": true,
          "validation": "^[a-zA-Z0-9@._-]+$"
        }
      ],
      "outputs": [
        {
          "name": "verify_disk_result",
          "type": "string",
          "description": "Trạng thái disk sau cleanup — PASS hoặc FAIL cùng số liệu"
        }
      ],
      "task_template": [
        {
          "name": "Verify Disk Space After Cleanup",
          "module": "ansible.builtin.command",
          "args": {
            "cmd": "df -h {{ target_path }}"
          },
          "register": "verify_disk_result"
        }
      ],
      "implementation": {
        "provider": "ansible",
        "estimatedDurationSec": 60
      },
      "verification": {
        "type": "embedded",
        "note": "Playbook self-verifies via Ansible module"
      },
      "compensation": {
        "type": "escalate",
        "action": "NOTIFY_ONCALL"
      },
      "riskDefault": "LOW"
    }
  ],
  "blueprints": [
    {
      "kind": "AutomationBlueprint",
      "metadata": {
        "name": "db-maintenance-pipeline",
        "version": "1.0.0"
      },
      "spec": {
        "owner": "DBA-Team",
        "domain": "CNTT",
        "description": "Quy trình bảo trì Database hoàn chỉnh: Pre-check -> Reboot Cycle -> Post-verify (3 Action chuỗi)",
        "steps": [
          {
            "stepIndex": 1,
            "action": "DB_PRECHECK"
          },
          {
            "stepIndex": 2,
            "action": "DB_RESTART_CYCLE"
          },
          {
            "stepIndex": 3,
            "action": "DB_POST_VERIFY"
          }
        ],
        "compensation": {
          "onFailure": "NOTIFY_ONCALL"
        },
        "status": "PUBLISHED"
      }
    },
    {
      "kind": "AutomationBlueprint",
      "metadata": {
        "name": "db-disk-health-check",
        "version": "1.0.0"
      },
      "spec": {
        "owner": "DevOps-Admin",
        "domain": "CNTT",
        "description": "",
        "steps": [
          {
            "stepIndex": 1,
            "action": "DISK_SPACE_CHECK",
            "inputs": {}
          },
          {
            "stepIndex": 2,
            "action": "DISK_CLEANUP_TMP",
            "inputs": {}
          },
          {
            "stepIndex": 3,
            "action": "DISK_VERIFY_AFTER",
            "inputs": {}
          }
        ],
        "compensation": {
          "onFailure": "NOTIFY_ONCALL"
        },
        "status": "PUBLISHED"
      }
    }
  ]
}
